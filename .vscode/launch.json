	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Chrome",
			"request": "launch",
			"type": "chrome",
			"url": "http://192.168.68.100:4200",
			"trace": true,
			"pathMapping": {
				"/": "${workspaceFolder}"
			},
			"webRoot": "${workspaceFolder}"
		},
		{
			"name": "Launch Chrome 130",
			"request": "launch",
			"type": "chrome",
			"preLaunchTask": "npm: startLocal",
			"url": "http://192.168.68.130:4200",
			"trace": true,
			"pathMapping": {
				"/": "${workspaceFolder}"
			},
			"webRoot": "${workspaceFolder}"
		},
		{
			"name": "ng serve",
			"type": "chrome",
			"request": "launch",
			"preLaunchTask": "npm: start",
			"url": "http://localhost:4200"
		},
		{
			"name": "ng serve 130",
			"type": "chrome",
			"request": "launch",
			"preLaunchTask": "npm: startLocal",
			"url": "http://192.168.68.130:4200"
		}
	]
}
